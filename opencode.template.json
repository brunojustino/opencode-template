{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "serena": {
      "type": "local",
      "command": ["serena", "start-mcp-server", "--context", "ide", "--project-from-cwd"],
      "enabled": true,
      "timeout": 30000
    }
  },
  "permission": {
    "bash": {
      "git add*": "allow",
      "git commit*": "allow",
      "git push*": "ask"
    },
    "skill": {
      "*": "allow"
    }
  }
}
